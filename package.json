{
  "name": "@vislite/canvas",
  "version": "1.1.0",
  "description": "一个更灵活好用的数据驱动的画布",
  "main": "./dist/canvas.min.js",
  "typings": "./types/index.d.ts",
  "scripts": {
    "start": "npm install && npm run dev",
    "dev": "oipage-cli run \"rollup --config ./rollup.config.js -w\" \"oipage-cli serve -p 20000\"",
    "build": "rollup --config ./rollup.config.js && terser ./dist/canvas.js --compress --mangle --output ./dist/canvas.min.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oi-contrib/vislite-plugin-canvas.git"
  },
  "author": {
    "name": "zxl20070701",
    "url": "https://zxl20070701.github.io/notebook/home.html"
  },
  "keywords": [
    "vislite",
    "plugin",
    "canvas"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "rollup": "^4.6.1",
    "terser": "^5.17.1"
  },
  "dependencies": {
    "oipage": "^1.5.0",
    "vislite": "^1.7.0"
  }
}
